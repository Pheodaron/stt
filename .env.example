# Compose settings on the host.
HOST_PORT=8080
GPU_DEVICE_ID=0

# Server and logging.
URL=0.0.0.0
PORT=8080
CLIENT_TYPE=grpc
PING_INTERVAL=30
LOG_LEVEL=info

# Request limits.
MAX_SEGMENT_BYTES=4194304
MAX_AUDIO_SECONDS=25
REQUEST_TIMEOUT=60

# Recognition windows.
BUFFER_SIZE=4
BUFFER_OVERLAP_MS=500

# Voice activity detection.
VAD_MODEL_PATH=/app/models/silero-v6.2.3/silero_vad.onnx
VAD_THRESHOLD=0.35
PADDING_DURATION_MS=250
VAD_MIN_SILENCE_MS=500

# GigaAM inference; CPU/CUDA is selected by the container image and Compose.
NUM_THREADS=2
MODEL_WORKERS=1
