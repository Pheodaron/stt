# Compose settings on the host.
HOST_PORT=8080
GPU_DEVICE_ID=0

# Server settings inside the container.
URL=0.0.0.0
PORT=8080
CLIENT_TYPE=grpc
BUFFER_SIZE=4
PING_INTERVAL=30
LOG_LEVEL=info
FRAME_DURATION_MS=10
PADDING_DURATION_MS=200
VAD_MODE=3

MODEL_PRECISION=fp32
MODEL_DIR=/app/models/gigaam-v3-fp32
NUM_THREADS=2
MODEL_WORKERS=1
FFMPEG_PATH=ffmpeg
MAX_SEGMENT_BYTES=4194304
MAX_AUDIO_SECONDS=25
REQUEST_TIMEOUT=60
