# syntax=docker/dockerfile:1
# 1. CPU SDK for Nemotron.
FROM docker.io/library/python:3.11.13-slim-bookworm AS nemo-build
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential git ninja-build libsentencepiece-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cmake==3.31.6
COPY script/build-nemo.sh /build-nemo.sh
ARG NEMO_BUILD_JOBS=2
RUN sh /build-nemo.sh

# 2. Nemotron checkpoint -> GGUF.
FROM nemo-build AS nemotron-model
RUN pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir /opt/nemo-source/llama.cpp/gguf-py numpy==2.2.6 PyYAML==6.0.2 huggingface-hub==0.36.0
WORKDIR /opt/nemo-source
RUN --mount=type=cache,id=nemotron-checkpoints,target=/checkpoints,sharing=locked \
    mkdir -p /model/nemotron-3-diarization-f32 && \
    python3 convert_model.py nvidia/Nemotron-3-Diarization --architecture diarization \
      --revision a435e9867d79e789e90053f9b6d6834053af564a --outtype f32 \
      --cache-dir /checkpoints/nemotron --outfile /model/nemotron-3-diarization-f32/model.gguf

# 3. GigaAM checkpoint -> FP32 ONNX.
FROM docker.io/library/python:3.11.13-slim-bookworm AS gigaam-model
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates git libgomp1 libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir 'gigaam @ git+https://github.com/salute-developers/GigaAM.git@7447938d791c4f3e643386ee22c33777004293a5'
COPY script/export-model-fp32.py /export-model-fp32.py
WORKDIR /model/gigaam-v3-fp32
RUN --mount=type=cache,id=gigaam-v3-checkpoints,target=/checkpoints,sharing=locked \
    GIGAAM_EXPORT_CHECKPOINTS=/checkpoints python3 /export-model-fp32.py

# 4. Ready-to-use Silero ONNX.
FROM docker.io/library/debian:bookworm-slim AS vad-model
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY script/prepare-vad.sh /prepare-vad.sh
RUN sh /prepare-vad.sh

# 5. Go server and sherpa-onnx libraries.
FROM docker.io/library/golang:1.25-bookworm AS build
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ARG GONOPROXY
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    sh script/build-container.sh

# 6. Runtime. Models are already inside the image.
FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg ca-certificates libstdc++6 && \
    rm -rf /var/lib/apt/lists/* && ln -s /usr/bin/ffmpeg /usr/local/bin/ffmpeg
WORKDIR /app
COPY --from=nemotron-model /model/nemotron-3-diarization-f32/ /app/models/nemotron-3-diarization-f32/
COPY --from=gigaam-model /model/gigaam-v3-fp32/ /app/models/gigaam-v3-fp32/
COPY --from=vad-model /model/silero-v6.2.3/ /app/models/silero-v6.2.3/
COPY --from=nemo-build /opt/nemo/lib/ /app/lib/
COPY --from=build /out/ /app/
ENV LD_LIBRARY_PATH=/app/lib URL=0.0.0.0 PORT=8080 MODEL_PROVIDER=cpu
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/stt-server"]
