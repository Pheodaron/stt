# syntax=docker/dockerfile:1
FROM docker.io/library/python:3.11.13-slim-bookworm AS nemo-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential git ninja-build libsentencepiece-dev ca-certificates && \
    rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir cmake==3.31.6
COPY script/nemo-version.env script/build-nemo.sh /opt/stt/
ARG NEMO_BUILD_JOBS=2
RUN sh /opt/stt/build-nemo.sh

FROM nemo-build AS nemotron-tools
RUN pip install --no-cache-dir torch==2.8.0 --index-url https://download.pytorch.org/whl/cpu && \
    pip install --no-cache-dir /opt/nemo-source/llama.cpp/gguf-py numpy==2.2.6 PyYAML==6.0.2 huggingface-hub==0.36.0
COPY script/prepare-nemotron.sh script/validate-nemotron.py script/test_validate_nemotron.py /opt/stt/
COPY internal/diarization/sdk/MODEL-LICENSE.OpenMDW-1.1 /opt/stt/MODEL-LICENSE.OpenMDW-1.1
RUN python3 /opt/stt/test_validate_nemotron.py && \
    cd /opt/nemo-source && python3 -c 'from conversion import diarization'

FROM nemotron-tools AS nemotron-model
RUN --mount=type=cache,id=nemotron-checkpoints,target=/checkpoints,sharing=locked \
    sh /opt/stt/prepare-nemotron.sh

FROM docker.io/library/python:3.11.13-slim-bookworm AS model-tools
ENV PIP_DISABLE_PIP_VERSION_CHECK=1 PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 XDG_CACHE_HOME=/tmp/.cache
WORKDIR /tmp
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git libgomp1 libsndfile1 && \
    rm -rf /var/lib/apt/lists/*
RUN python3 -m pip install 'torch==2.8.0' 'torchaudio==2.8.0' \
      --index-url https://download.pytorch.org/whl/cpu && \
    python3 -m pip install 'gigaam @ git+https://github.com/salute-developers/GigaAM.git@7447938d791c4f3e643386ee22c33777004293a5'
COPY script/export-model-fp32.sh script/export-model-fp32.py script/validate-model-fp32.py /opt/model-export/
COPY script/licenses/ /opt/model-export/licenses/

FROM model-tools AS vad-model
WORKDIR /opt/vad
COPY script/prepare-vad.sh script/prepare-vad.sh
RUN sh script/prepare-vad.sh

FROM model-tools AS model-export
RUN --mount=type=cache,id=gigaam-v3-checkpoints,target=/checkpoints,sharing=locked \
    sh /opt/model-export/export-model-fp32.sh /model/gigaam-v3-fp32

FROM docker.io/library/debian:bookworm-slim AS ffmpeg-build
RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential musl-tools nasm pkg-config curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*
COPY --chmod=644 script/build-ffmpeg.sh /usr/local/bin/build-ffmpeg
ARG FFMPEG_BUILD_JOBS=2
RUN sh /usr/local/bin/build-ffmpeg

FROM docker.io/library/golang:1.25-bookworm AS build
WORKDIR /src
ARG GOPROXY=https://proxy.golang.org,direct
ARG GONOPROXY
COPY . .
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    sh script/build-container.sh

FROM docker.io/library/debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 && \
    rm -rf /var/lib/apt/lists/*
WORKDIR /app
# Keep the immutable model layer before application files for cache reuse.
COPY --from=model-export /model/gigaam-v3-fp32/ /app/models/gigaam-v3-fp32/
COPY --from=nemotron-model /model/nemotron-3-diarization-f32/ /app/models/nemotron-3-diarization-f32/
COPY --from=nemo-build /opt/nemo/lib/ /app/lib/
COPY --from=nemo-build /opt/nemo/share/licenses/ /app/licenses/nemo/
COPY --from=vad-model /opt/vad/models/silero-v6.2.3/ /app/models/silero-v6.2.3/
COPY --from=build /out/ /app/
COPY --from=ffmpeg-build /opt/ffmpeg/bin/ffmpeg /usr/local/bin/ffmpeg
COPY --from=ffmpeg-build /opt/ffmpeg/licenses/ /app/licenses/ffmpeg/
ENV LD_LIBRARY_PATH=/app/lib URL=0.0.0.0 PORT=8080 MODEL_PROVIDER=cpu
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/app/stt-server"]
